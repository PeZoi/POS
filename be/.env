#############################
# Spring Boot (.env import)
# File này dùng cho local/dev.
# KHÔNG commit file .env thật có secrets.
#############################

# ===============================
# DATASOURCE (MYSQL)
# ===============================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/pos?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# ===============================
# POS SESSION / PIN
# ===============================
# Nên là chuỗi ngẫu nhiên >= 32 ký tự trên production
POS_SESSION_SECRET=pos-dev-secret-change-in-production-min-32-chars
POS_SESSION_TTL_SECONDS=43200

# Khoá PIN theo thiết bị/IP
POS_PIN_MAX_FAILED=5
POS_PIN_LOCK_MINUTES=1

# ===============================
# TELEGRAM
# ===============================
# Master switch (trên server) — trong UI còn có telegramEnabled lưu DB
TELEGRAM_BOT_TOKEN=8460783913:AAHhPfnGGc7tn-5fMnUy_eiXEaIR-2z2P2U
TELEGRAM_CHAT_ID=1777363419
APP_ENV=local
POS_TELEGRAM_SERVICE_NAME=pos-api

# ===============================
# BACKUP MYSQL (mysqldump)
# ===============================
# Master switch (trên server) — trong UI còn có backupEnabled + backupTime lưu DB
POS_BACKUP_DIR=./backups
# Windows ví dụ: C:\\Program Files\\MySQL\\MySQL Server 8.0\\bin\\mysqldump.exe
POS_MYSQLDUMP_CMD=mysqldump
# Poller để đọc settings (ms)
POS_BACKUP_POLL_MS=30000
